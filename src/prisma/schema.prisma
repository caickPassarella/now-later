// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output  = "../../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Thought {
  id        Int       @id @default(autoincrement())
  content   String
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  tag       String?

  @@index([deletedAt])
}

model Daily {
  id         Int       @id @default(autoincrement())
  content    String
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  occurredAt DateTime?
  tag       String?

  @@index([occurredAt])
  @@index([deletedAt])
}