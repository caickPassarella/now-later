# Turso database — https://app.turso.tech
# Run `turso auth login` then `turso db show <db-name>` to get the URL
# Used as syncUrl for the local embedded replica — reads are served from local-replica.db
DATABASE_URL="libsql://your-db.turso.io"
# Run `turso db tokens create <db-name>` to generate a token
TURSO_AUTH_TOKEN=""

# AppSignal — https://appsignal.com
APPSIGNAL_PUSH_API_KEY=""
NEXT_PUBLIC_APPSIGNAL_JS_KEY=""
